# Copy to .env in this directory if you want to override the local defaults.
# docker compose reads .env automatically. The defaults below match docker-compose.yml.

# Required by the API at import/startup. Compose supplies these if unset.
MONGO_URL=mongodb://mongo:27017
DB_NAME=winniehou
JWT_SECRET=local-dev-jwt-secret-change-me
EMAIL_FROM_NAME=Winnie Hou
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=local-admin-password

# Optional. Leave blank for local use.
EMAIL_REPLY_TO=
CORS_ORIGINS=http://localhost:43123,http://127.0.0.1:43123
APP_NAME=winnie-lms

# Payments stay in the app's built-in test fallback when this is empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Claude resume parsing and outbound email need Emergent keys. The API still
# starts without them; those features return errors until the keys are set.
# emergentintegrations is not on public PyPI, so it is omitted from the image.
EMERGENT_LLM_KEY=
EMERGENT_EMAIL_KEY=

# Bunny Stream direct upload. Lesson pages still play direct video URLs without these.
BUNNY_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_TOKEN_AUTH_KEY=

# Frontend build args. Leave REACT_APP_BACKEND_URL empty so the UI calls
# same-origin /api (nginx on port 43123 proxies to the API). Set a full origin
# only if the browser should call the API port directly, for example
# http://127.0.0.1:43124
REACT_APP_BACKEND_URL=
REACT_APP_CALENDLY_URL=
REACT_APP_STRIPE_DEPOSIT_URL=
